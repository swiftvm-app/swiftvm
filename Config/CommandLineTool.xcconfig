// Build settings of the swiftvm command-line tool, which is embedded in the app at Contents/Helpers.
//
// The target is called CommandLineTool rather than swiftvm because build folders are named after targets
// and modules, and on a case-insensitive disk "swiftvm" and "SwiftVM" (the app) would be the same folder.

PRODUCT_NAME = swiftvm
PRODUCT_MODULE_NAME = CommandLineTool
PRODUCT_BUNDLE_IDENTIFIER = dev.swiftvm.SwiftVM.swiftvm

MACOSX_DEPLOYMENT_TARGET = 27.0
SDKROOT = macosx
ARCHS = arm64
SWIFT_VERSION = 6.0

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = YES
SKIP_INSTALL = YES

#include? "Signing.local.xcconfig"
