// How Cloudflare serves the site: as a Worker that is nothing but the files of dist/.
{
    // The name the Worker has in the Cloudflare dashboard. A build fails if the two differ.
    "name": "swiftvm",
    "compatibility_date": "2026-10-11",
    "assets": {
        "directory": "./dist/",
        // A folder's index.html at the folder's address, and 404.html for what isn't there.
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
    }
}
