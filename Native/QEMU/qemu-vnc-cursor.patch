@@ -1362,6 +1364,17 @@
 QEMUCursor *qemu_console_get_cursor(QemuConsole *con)
 {
     return QEMU_IS_GRAPHIC_CONSOLE(con) ? QEMU_GRAPHIC_CONSOLE(con)->cursor : NULL;
+}
+
+bool qemu_console_get_cursor_visible(QemuConsole *con)
+{
+    if (!QEMU_IS_GRAPHIC_CONSOLE(con)) {
+        return false;
+    }
+
+    /* Keep define-only devices visible until they explicitly set visibility. */
+    return !QEMU_GRAPHIC_CONSOLE(con)->cursor_mouse_set ||
+           QEMU_GRAPHIC_CONSOLE(con)->cursor_on;
 }
 
