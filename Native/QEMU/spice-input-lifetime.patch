+static void inputs_remove()
+{
+    SpiceCoreInterface *core = basic_event_loop_init();
+    SpiceServer *server = spice_server_new();
+    g_assert_cmpint(spice_server_init(server, core), ==, 0);
+
+    auto keyboard = g_new0(TestKeyboard, 1);
+    auto mouse = g_new0(SpiceMouseInstance, 1);
+    keyboard->instance.base.sif = &keyboard_interface.base;
+    mouse->base.sif = &mouse_interface.base;
+    g_assert_cmpint(spice_server_add_interface(server, &keyboard->instance.base), ==, 0);
+    g_assert_cmpint(spice_server_add_interface(server, &mouse->base), ==, 0);
+
+    RedChannelCapabilities caps = {};
+    uint32_t common_caps = 1 << SPICE_COMMON_CAP_MINI_HEADER;
+    caps.num_common_caps = 1;
+    caps.common_caps = static_cast<uint32_t *>(spice_memdup(&common_caps, sizeof(common_caps)));
+    RedClient *client = red_client_new(server, FALSE);
+    red::shared_ptr<MainChannel> main_channel(main_channel_new(server));
+    int main_socket, input_socket;
+    g_assert_nonnull(main_channel_link(main_channel.get(), client,
+                                     create_dummy_stream(server, &main_socket), 0, FALSE, &caps));
+    auto inputs = inputs_channel_client_create(
+        reds_find_channel(server, SPICE_CHANNEL_INPUTS, 0),
+        client, create_dummy_stream(server, &input_socket), &caps);
+    g_assert_nonnull(inputs);
+    red_channel_capabilities_reset(&caps);
+
+    const uint8_t key_down[] = {SPICE_MSGC_INPUTS_KEY_DOWN, 0, 4, 0, 0, 0, 0x1e, 0, 0, 0};
+    g_assert_cmpint(socket_write(input_socket, key_down, sizeof(key_down)), ==, sizeof(key_down));
+    inputs->receive();
+    g_assert_cmpuint(keyboard->pressed, ==, 1);
+
+    // QEMU removes and frees these interfaces before disconnecting SPICE clients.
+    g_assert_cmpint(spice_server_remove_interface(&keyboard->instance.base), ==, 0);
+    g_assert_cmpuint(keyboard->released, ==, 1);
+    g_assert_null(keyboard->instance.st);
+    g_assert_cmpint(spice_server_remove_interface(&mouse->base), ==, 0);
+    g_assert_null(mouse->st);
+    g_free(keyboard);
+    g_free(mouse);
+    client->destroy();
+    main_channel.reset();
+    socket_close(input_socket);
+    socket_close(main_socket);
+
+    // Removal must also allow replacement; server destruction owns the remaining state.
+    keyboard = g_new0(TestKeyboard, 1);
+    mouse = g_new0(SpiceMouseInstance, 1);
+    keyboard->instance.base.sif = &keyboard_interface.base;
+    mouse->base.sif = &mouse_interface.base;
+    g_assert_cmpint(spice_server_add_interface(server, &keyboard->instance.base), ==, 0);
+    g_assert_cmpint(spice_server_add_interface(server, &mouse->base), ==, 0);
+    spice_server_destroy(server);
+    g_assert_null(keyboard->instance.st);
+    g_assert_null(mouse->st);
+    g_free(keyboard);
+    g_free(mouse);
+    basic_event_loop_destroy();
+}
