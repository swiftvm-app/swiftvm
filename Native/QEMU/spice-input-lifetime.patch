+struct TestKeyboard {
+    SpiceKbdInstance instance;
+    unsigned pressed;
+    unsigned released;
+};
+
+static void keyboard_scan(SpiceKbdInstance *instance, uint8_t scan)
+{
+    auto keyboard = reinterpret_cast<TestKeyboard *>(instance);
+    if (scan & 0x80) {
+        ++keyboard->released;
+    } else {
+        ++keyboard->pressed;
+    }
+}
