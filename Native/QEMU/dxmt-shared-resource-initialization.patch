From 675a3526951221081b62fabe5475d367b2f2b036 Mon Sep 17 00:00:00 2001
From: Henry Pham <duchuykun@gmail.com>
Date: Thu, 1 Oct 2026 19:27:42 +0700
Subject: [PATCH] d3d11: don't let a new texture's contents be wiped or read
 too early

Under Neptune, parts of Windows' text drew blank with 3D on: in the
taskbar, the Start menu and menus. Two races in resource creation caused
it. Both lose the opaque texel DirectComposition keeps at (0,0) of each
new atlas, and DWM multiplies every sprite it batches against that atlas
by it.

- Shared textures and the resource initializer. A shared texture is a
  linear plane of fresh anonymous shm, which reads as zero, so it needs no
  clear, and its initial data can be copied straight into the mapping. The
  initializer's GPU clear was seen landing after a new texture's first
  writes and wiping them. Shared textures skip the initializer now.
- Immutable resources that come without their contents. DXMT marks
  immutable resources GPU-readonly, and leaves them out of its hazard
  tracking. That's safe when their contents come with them. Neptune
  creates every resource without data, and sends the contents after, as
  an update. The update and the first read then land in different
  encoders with nothing ordering them, so a read could see the resource
  before its contents. Only resources created with their data are
  readonly now. Shared textures never are: their creator may fill them
  later, and other processes see the writes.
---
 src/d3d11/d3d11_buffer.cpp                |  4 +++-
 src/d3d11/d3d11_texture_device.cpp        | 22 ++++++++++++++++++++--
 src/d3d11/d3d11_texture_linear.cpp        |  4 +++-
 src/d3d11/d3d11_texture_shared_native.cpp |  5 +++--
 4 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/src/d3d11/d3d11_buffer.cpp b/src/d3d11/d3d11_buffer.cpp
index 8ed8a4e6b..850549feb 100644
--- a/src/d3d11/d3d11_buffer.cpp
+++ b/src/d3d11/d3d11_buffer.cpp
@@ -94,7 +94,9 @@ class D3D11Buffer : public TResourceBase<tag_buffer> {
     if (!m_parent->IsTraced() && pDesc->Usage == D3D11_USAGE_DYNAMIC)
       flags.set(BufferAllocationFlag::CpuWriteCombined);
     // if (pDesc->Usage != D3D11_USAGE_DEFAULT)
-    if (pDesc->Usage == D3D11_USAGE_IMMUTABLE)
+    /* Changed for VMPal, 2026-10-01: readonly (untracked) only when the
+     * contents come with the buffer; see CreateDeviceTextureInternal. */
+    if (pDesc->Usage == D3D11_USAGE_IMMUTABLE && pInitialData)
       flags.set(BufferAllocationFlag::GpuReadonly);
     if (pDesc->Usage != D3D11_USAGE_DYNAMIC) {
       if (pInitialData)
diff --git a/src/d3d11/d3d11_texture_device.cpp b/src/d3d11/d3d11_texture_device.cpp
index b76df64a5..2abdb0257 100644
--- a/src/d3d11/d3d11_texture_device.cpp
+++ b/src/d3d11/d3d11_texture_device.cpp
@@ -439,7 +439,21 @@ HRESULT CreateDeviceTextureInternal(MTLD3D11Device *pDevice,
       if (FAILED(hr))
         return hr;
       texture = std::move(shm_texture);
-      initialize(std::move(shm_allocation));
+      /* Changed for VMPal, 2026-10-01: keep shared textures away from the
+       * resource initializer. A fresh shm object reads as zero, and initial
+       * data can be copied straight into the mapping. The initializer's GPU
+       * clear was seen landing after a new texture's first writes and wiping
+       * them: the opaque texel DirectComposition keeps at (0,0) of each atlas
+       * came out transparent, and DWM drew text batched against it blank. */
+      if (pInitialData) {
+        const D3D11_SUBRESOURCE_DATA &data = pInitialData[0];
+        auto dst = reinterpret_cast<uint8_t *>(shm_allocation->mappedMemory);
+        auto src = reinterpret_cast<const uint8_t *>(data.pSysMem);
+        size_t row_bytes = std::min<size_t>((size_t)finalDesc.Width * format_desc.BytesPerTexel, data.SysMemPitch);
+        for (unsigned row = 0; dst && src && row < finalDesc.Height; row++)
+          memcpy(dst + row * pod.stride, src + (size_t)row * data.SysMemPitch, row_bytes);
+      }
+      texture->rename(std::move(shm_allocation));
       *ppTexture = reinterpret_cast<typename tag::COM_IMPL *>(
           ref(new DeviceTexture<tag>(&finalDesc, std::move(texture), pod, pDevice))
       );
@@ -514,7 +528,11 @@ HRESULT CreateDeviceTextureInternal(MTLD3D11Device *pDevice,
   flags.set(finalDesc.CPUAccessFlags ? TextureAllocationFlag::GpuManaged : TextureAllocationFlag::GpuPrivate);
   if (!(finalDesc.BindFlags & (D3D11_BIND_UNORDERED_ACCESS | D3D11_BIND_RENDER_TARGET | D3D11_BIND_DEPTH_STENCIL)))
     flags.set(TextureAllocationFlag::ShaderReadonly);
-  if (finalDesc.Usage == D3D11_USAGE_IMMUTABLE)
+  /* Changed for VMPal, 2026-10-01: a GPU-readonly resource isn't tracked,
+   * which is safe only when its contents come with it.  A client can create
+   * an immutable resource without data and fill it after (Neptune does), and
+   * then a read could start before that write had landed. */
+  if (finalDesc.Usage == D3D11_USAGE_IMMUTABLE && pInitialData)
     flags.set(TextureAllocationFlag::GpuReadonly);
   if (single_subresource && (finalDesc.BindFlags & D3D11_BIND_DEPTH_STENCIL)) {
     Rc<RenamableTexturePool> renamable = new RenamableTexturePool(texture.ptr(), 32, flags);
diff --git a/src/d3d11/d3d11_texture_linear.cpp b/src/d3d11/d3d11_texture_linear.cpp
index e250d6e05..7c46b5da5 100644
--- a/src/d3d11/d3d11_texture_linear.cpp
+++ b/src/d3d11/d3d11_texture_linear.cpp
@@ -51,7 +51,9 @@ TDynamicLinearTexture(
     if (!this->m_parent->IsTraced() && pDesc->Usage == D3D11_USAGE_DYNAMIC)
       flags.set(TextureAllocationFlag::CpuWriteCombined);
     // if (pDesc->Usage != D3D11_USAGE_DEFAULT)
-    if (pDesc->Usage == D3D11_USAGE_IMMUTABLE)
+    /* Changed for VMPal, 2026-10-01: readonly (untracked) only when the
+     * contents come with the texture; see CreateDeviceTextureInternal. */
+    if (pDesc->Usage == D3D11_USAGE_IMMUTABLE && pInitialData)
       flags.set(TextureAllocationFlag::GpuReadonly);
     if (pDesc->Usage != D3D11_USAGE_DYNAMIC)
       flags.set(TextureAllocationFlag::GpuManaged);
diff --git a/src/d3d11/d3d11_texture_shared_native.cpp b/src/d3d11/d3d11_texture_shared_native.cpp
index 94cdad354..9a049c6cc 100644
--- a/src/d3d11/d3d11_texture_shared_native.cpp
+++ b/src/d3d11/d3d11_texture_shared_native.cpp
@@ -182,10 +182,11 @@ AllocateShmLinearTexture2D(
   linear_info.mach_port = 0;
   linear_info.options = WMTResourceHazardTrackingModeUntracked;
 
+  /* Changed for VMPal, 2026-10-01: never readonly (untracked).  The
+   * creator may fill an immutable texture after creating it, and an importer
+   * sees another process's writes. */
   Flags<TextureAllocationFlag> flags;
   flags.set(TextureAllocationFlag::Shared);
-  if (finalDesc.Usage == D3D11_USAGE_IMMUTABLE)
-    flags.set(TextureAllocationFlag::GpuReadonly);
   if (!(finalDesc.BindFlags & (D3D11_BIND_UNORDERED_ACCESS | D3D11_BIND_RENDER_TARGET | D3D11_BIND_DEPTH_STENCIL)))
     flags.set(TextureAllocationFlag::ShaderReadonly);
 
