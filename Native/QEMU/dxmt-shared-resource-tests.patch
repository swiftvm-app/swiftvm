+
+static void
+test_shared_initialization(Ctx &c) {
+  const char *T = "shared_initialization";
+  for (auto format : {DXGI_FORMAT_R8G8B8A8_UNORM, DXGI_FORMAT_A8_UNORM}) {
+    const unsigned bpp = format == DXGI_FORMAT_A8_UNORM ? 1 : 4;
+    D3D11_TEXTURE2D_DESC desc = {};
+    desc.Width = 63;
+    desc.Height = 17;
+    desc.MipLevels = desc.ArraySize = desc.SampleDesc.Count = 1;
+    desc.Format = format;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    desc.MiscFlags = D3D11_RESOURCE_MISC_SHARED;
+    std::vector<uint8_t> bytes((desc.Width * bpp + 16) * desc.Height, 0x7f);
+    D3D11_SUBRESOURCE_DATA initial = {bytes.data(), desc.Width * bpp + 16, 0};
+    for (bool has_initial : {false, true}) {
+      emit("[INFO] %s: format=%u initial_data=%u", T, (unsigned)format, (unsigned)has_initial);
+      Com<ID3D11Texture2D> texture;
+      CHECK_HR(T, c.device->CreateTexture2D(&desc, has_initial ? &initial : nullptr, &texture));
+      Com<IDXGIResource> resource;
+      CHECK_HR(T, texture->QueryInterface(__uuidof(IDXGIResource), (void **)&resource));
+      HANDLE handle = nullptr;
+      CHECK_HR(T, resource->GetSharedHandle(&handle));
+      auto shared = static_cast<const dxmt_shared_texture_handle *>(handle);
+      CHECK(T, shared->magic == DXMT_SHARED_TEXTURE_MAGIC, return);
+      int fd = shared->fd;
+      struct stat info = {};
+      CHECK(T, fstat(fd, &info) == 0, return);
+      auto mapping = static_cast<uint8_t *>(mmap(nullptr, info.st_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0));
+      CHECK(T, mapping != MAP_FAILED, return);
+      CHECK(T, mapping[0] == (has_initial ? 0x7f : 0));
+      /* A peer can populate the mapping before this device submits any work.
+       * A queued initializer must not erase those writes. */
+      memset(mapping, 0xb5, info.st_size);
+      auto readback = readback_tex2d(c, texture, 0, bpp);
+      bool preserved = readback.size() == desc.Width * desc.Height * bpp;
+      for (auto byte : readback) preserved &= byte == 0xb5;
+      CHECK(T, preserved);
+      munmap(mapping, info.st_size);
+    }
+  }
 }
 
