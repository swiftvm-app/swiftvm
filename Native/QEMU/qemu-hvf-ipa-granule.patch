+/*
+ * The size of the pages the guest's memory is mapped in, or 0 for the host's.
+ * Mapping in 4K pages lets the guest place GPU memory the host hands out at
+ * 4K offsets, which a 16K host page can't follow.
+ */
+extern uint32_t hvf_ipa_granule_size;
 
