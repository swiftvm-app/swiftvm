+/*
+ * A control-method battery uses the guests' own ACPI drivers. Capacities are
+ * normalized to 10000 mWh: this shares charge and power state, not the Mac's
+ * battery health or an invented estimate of its remaining run time.
+ */
+void acpi_dsdt_add_battery(Aml *scope, hwaddr base)
+{
+    Aml *bat = aml_device("BAT0");
+    Aml *ac = aml_device("AC0");
+    Aml *field, *method, *pkg, *crs;
+    const uint32_t bif[] = { 0, 10000, 10000, 1, 10000, 1000, 500, 100, 100 };
+    const uint32_t bix[] = {
+        0, 0, 10000, 10000, 1, 10000, 1000, 500, 0xffffffff, 100000,
+        0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 100, 100
+    };
+    const char *strings[] = { "Mac battery", "0", "LION", "SwiftVM" };
+    int i;
+
+    aml_append(bat, aml_name_decl("_HID", aml_eisaid("PNP0C0A")));
+    aml_append(bat, aml_name_decl("_UID", aml_int(0)));
+    crs = aml_resource_template();
+    aml_append(crs, aml_memory32_fixed(base, ACPI_GED_BATTERY_LEN, AML_READ_ONLY));
+    aml_append(bat, aml_name_decl("_CRS", crs));
+    aml_append(bat, aml_operation_region("BREG", AML_SYSTEM_MEMORY,
+                                        aml_int(base), ACPI_GED_BATTERY_LEN));
+    field = aml_field("BREG", AML_DWORD_ACC, AML_NOLOCK, AML_PRESERVE);
+    aml_append(field, aml_named_field("BPST", 32));
+    aml_append(field, aml_named_field("BSTT", 32));
+    aml_append(field, aml_named_field("BCAP", 32));
+    aml_append(field, aml_named_field("ACST", 32));
+    aml_append(bat, field);
+
+    method = aml_method("_STA", 0, AML_NOTSERIALIZED);
+    aml_append(method, aml_return(aml_name("BPST")));
+    aml_append(bat, method);
+
+    pkg = aml_package(13);
+    for (i = 0; i < ARRAY_SIZE(bif); i++) {
+        aml_append(pkg, aml_int(bif[i]));
+    }
+    for (i = 0; i < ARRAY_SIZE(strings); i++) {
+        aml_append(pkg, aml_string("%s", strings[i]));
+    }
+    method = aml_method("_BIF", 0, AML_NOTSERIALIZED);
+    aml_append(method, aml_return(pkg));
+    aml_append(bat, method);
+
+    pkg = aml_package(20);
+    for (i = 0; i < ARRAY_SIZE(bix); i++) {
+        aml_append(pkg, aml_int(bix[i]));
+    }
+    for (i = 0; i < ARRAY_SIZE(strings); i++) {
+        aml_append(pkg, aml_string("%s", strings[i]));
+    }
+    method = aml_method("_BIX", 0, AML_NOTSERIALIZED);
+    aml_append(method, aml_return(pkg));
+    aml_append(bat, method);
+
+    pkg = aml_package(4);
+    aml_append(pkg, aml_int(0));
+    aml_append(pkg, aml_int(0xffffffff)); /* Unknown rate, no time estimate. */
+    aml_append(pkg, aml_int(0));
+    aml_append(pkg, aml_int(10000));
+    method = aml_method("_BST", 0, AML_SERIALIZED);
+    aml_append(method, aml_store(pkg, aml_local(0)));
+    aml_append(method, aml_store(aml_name("BSTT"),
+                                aml_index(aml_local(0), aml_int(0))));
+    aml_append(method, aml_store(aml_name("BCAP"),
+                                aml_index(aml_local(0), aml_int(2))));
+    aml_append(method, aml_return(aml_local(0)));
+    aml_append(bat, method);
+    /* Every change is notified, including a crossing of any requested trip point. */
+    aml_append(bat, aml_method("_BTP", 1, AML_NOTSERIALIZED));
+    aml_append(scope, bat);
+
+    aml_append(ac, aml_name_decl("_HID", aml_string("ACPI0003")));
+    aml_append(ac, aml_name_decl("_UID", aml_int(0)));
+    method = aml_method("_PSR", 0, AML_NOTSERIALIZED);
+    aml_append(method, aml_return(aml_name("\\_SB.BAT0.ACST")));
+    aml_append(ac, method);
+    aml_append(scope, ac);
+}
+
+static uint64_t battery_read(void *opaque, hwaddr addr, unsigned size)
+{
+    AcpiGedState *s = opaque;
+    uint32_t status = s->battery_status;
+    bool present = status & ACPI_BATTERY_PRESENT;
+    bool on_ac = !present || (status & ACPI_BATTERY_ON_AC);
+
+    switch (addr) {
+    case 0: /* _STA: the slot always exists, its battery need not. */
+        return present ? 0x1f : 0x0f;
+    case 4: /* _BST state: discharging, charging, or neither. */
+        return !on_ac ? 1 : (status & ACPI_BATTERY_CHARGING) ? 2 : 0;
+    case 8:
+        return present ? (status & 0x7f) * 100 : 0xffffffff;
+    case 12:
+        return on_ac;
+    default:
+        return 0;
+    }
+}
+
+static void battery_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    /* The guest cannot change the host's battery. */
+}
+
+static const MemoryRegionOps battery_ops = {
+    .read = battery_read,
+    .write = battery_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void battery_get_status(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    uint32_t status = ACPI_GED(obj)->battery_status;
+    visit_type_uint32(v, name, &status, errp);
+}
+
+static void battery_set_status(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    AcpiGedState *s = ACPI_GED(obj);
+    uint32_t status;
+
+    if (!visit_type_uint32(v, name, &status, errp)) {
+        return;
+    }
+    if ((status & ~0x77f) || (status & 0x7f) > 100 ||
+        (status && !(status & ACPI_BATTERY_PRESENT)) ||
+        ((status & ACPI_BATTERY_CHARGING) && !(status & ACPI_BATTERY_ON_AC))) {
+        error_setg(errp, "Invalid battery status");
+        return;
+    }
+    /* A restored guest can remember a battery even when this host has none. */
+    if (!s->battery_status_received || status != s->battery_status) {
+        s->battery_status_received = true;
+        s->battery_status = status;
+        s->ged_state.sel |= ACPI_GED_BATTERY_EVT;
+        qemu_irq_pulse(s->irq);
+    }
+}
